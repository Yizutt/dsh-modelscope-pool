{
  "name": "dsh-modelscope-pool",
  "version": "0.11.1",
  "description": "魔搭多 Key 聚合网关 + DSH 原生插件：模型不变，Key 遇限流、额度不足、无权限或令牌失效自动无感换下一个；自动识别国际版/国内版令牌；Key 池管理、魔粒用量、多语言界面；也可在网页版/桌面版管理。",
  "license": "MIT",
  "author": "Yizutt",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yizutt/dsh-modelscope-pool.git"
  },
  "homepage": "https://github.com/Yizutt/dsh-modelscope-pool",
  "bugs": {
    "url": "https://github.com/Yizutt/dsh-modelscope-pool/issues"
  },
  "keywords": [
    "dsh",
    "dsh-go",
    "modelscope",
    "魔搭",
    "llm-gateway",
    "openai-compatible",
    "key-pool"
  ],
  "private": false,
  "type": "module",
  "main": "lib/index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0-0"
  },
  "dshGo": {
    "v": 1,
    "title": {
      "zh": "魔搭 Key 池",
      "en": "ModelScope keys"
    },
    "icon": "cloud",
    "contributes": {
      "composer.strip": [
        {
          "id": "pool-strip",
          "icon": "cloud",
          "panel": "pool"
        }
      ],
      "panels": [
        {
          "id": "pool",
          "title": {
            "zh": "魔搭 Key 池",
            "en": "ModelScope keys"
          },
          "icon": "cloud",
          "placement": [
            "session.tab",
            "chat.panel",
            "features"
          ]
        },
        {
          "id": "key",
          "title": {
            "zh": "Key 详情",
            "en": "Key detail"
          },
          "icon": "info",
          "placement": [
            "chat.panel",
            "features"
          ]
        },
        {
          "id": "models",
          "title": {
            "zh": "魔搭模型",
            "en": "MS models"
          },
          "icon": "model",
          "placement": [
            "session.tab",
            "chat.panel",
            "features"
          ]
        }
      ]
    }
  }
}
